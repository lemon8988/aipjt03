# 복사해서 .env 로 만든 뒤 값을 채우세요. .env 는 절대 커밋/제출하지 않습니다. (NF3001)

# 카카오 디벨로퍼스 > 내 애플리케이션 > REST API 키 (카카오맵/로컬 API 활성화 필요)
KAKAO_REST_KEY=

# LLM: GPT (OpenAI 호환 Chat Completions). SSAFY GMS 를 쓰면 GMS 가 안내하는 OpenAI 호환 주소(…/v1)를 넣는다.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# 이동시간 제공자: kakao(실제) | mock(개발용 모의 추정 — 실제 이동시간 아님)
ROUTE_PROVIDER=kakao

# 배포 시: 프론트엔드(Netlify) 주소. 쉼표로 여러 개 가능. 예) https://my-planner.netlify.app
CORS_ORIGINS=

# 선택: 실패 주입 (검증용). 형식 "tool:CODE[:every_n]" 쉼표 구분. 예) get_route:API_ERROR:3
FAIL_INJECT=

# 선택: 이상 징후(F3020) 검증용 주입. repeat_call | unplanned_call | missing_events (운영에서는 비워 둔다)
ANOMALY_INJECT=

# 선택: 로깅 Agent 끄기(발행이 구독자에 의존하지 않는지 확인용) 1 이면 끔
DISABLE_LOGGING_AGENT=0

# 선택: 설정값 조정 (기본값은 설계서 6장)
# T_MAX=90
# G_MAX=30
# MAX_REPLAN=3
# CALL_BUDGET=100
