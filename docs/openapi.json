            "type": "string",
            "title": "Status"
          },
          "kakao_key": {
            "type": "boolean",
            "title": "Kakao Key"
          },
          "llm_key": {
            "type": "boolean",
            "title": "Llm Key"
          },
          "route_provider": {
            "type": "string",
            "title": "Route Provider"
          },
          "logging_agent": {
            "type": "boolean",
