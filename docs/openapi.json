  "components": {
    "schemas": {
      "ChatChoice": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "priority",
              "disambiguate",
              "patch"
            ],
            "title": "Kind"
          },
          "value": {
            "title": "Value"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "title": "ChatChoice"
      },
      "ChatRequest": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 500,
            "title": "Message",
            "default": ""
          },
          "choice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatChoice"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "answer",
              "ask",
              "error"
            ],
            "title": "Type"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "ask": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ask"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "timeline": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Timeline",
            "default": []
          },
          "evaluation": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evaluation"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "type",
          "status",
          "answer"
        ],
        "title": "ChatResponse"
      },
      "Conflict": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "start_time": {
            "type": "string",
            "title": "Start Time"
          },
          "end_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Time"
          },
          "station": {
            "type": "string",
            "title": "Station"
          }
        },
        "type": "object",
        "required": [
          "id",
          "date",
          "start_time",
          "station"
