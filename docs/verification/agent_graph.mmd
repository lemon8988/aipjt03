---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	analyze(analyze)
	plan(plan)
	execute(execute)
	judge(judge)
	replan(replan)
	respond(respond)
	__end__([<p>__end__</p>]):::last
	__start__ --> analyze;
	analyze -.-> plan;
	analyze -.-> respond;
	execute --> judge;
	judge -.-> replan;
	judge -.-> respond;
	plan -.-> execute;
	plan -.-> respond;
	replan --> plan;
	respond --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
